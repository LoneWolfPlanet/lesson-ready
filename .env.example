# Copy to .env.local (not committed) and fill in. Every value is read in src/config.ts.

# ---------- Sign-in ----------
# "mock" signs in with a fake teacher (no Azure needed). "msal" uses Microsoft Entra External ID.
VITE_AUTH_MODE=msal

# App registration (SPA platform) in your External ID tenant -> Application (client) ID
VITE_AUTH_CLIENT_ID=00000000-0000-0000-0000-000000000000

# External ID authority: subdomain host + Directory (tenant) ID path, with a trailing slash.
# e.g. https://lessongenerator.ciamlogin.com/7f5fb7f1-0000-0000-0000-000000000000/
# The tenant ID is required: without it MSAL's issuer check fails (endpoints_resolution_error).
VITE_AUTH_AUTHORITY=https://YOUR-SUBDOMAIN.ciamlogin.com/YOUR-TENANT-ID/
VITE_AUTH_KNOWN_AUTHORITY=YOUR-SUBDOMAIN.ciamlogin.com

# Must exactly match a redirect URI on the app registration (SPA platform).
# Leave as /redirect.html; the full URL is built from the current origin.
VITE_AUTH_REDIRECT_PATH=/redirect.html

# Show the "Continue with Google" button. Turn on only after Google is added as an
# identity provider AND ticked in the user flow. (Mock mode always shows it.)
VITE_AUTH_GOOGLE_ENABLED=false

# Optional: send the "Continue with Google" button straight to Google.
# Leave blank to show the External ID sign-in page, where Google is one of the options.
# Try "Google.com" and test on desktop and mobile browsers before shipping.
VITE_AUTH_GOOGLE_DOMAIN_HINT=

# ---------- Lesson pack API ----------
# "mock" runs a fake generator in the browser. "http" calls your backend.
VITE_API_MODE=http
VITE_API_BASE_URL=https://ca-lessonpack-api.jollypond-8ff5b247.westus2.azurecontainerapps.io

# Delegated scope(s) exposed by the API's app registration, space-separated.
VITE_API_SCOPES=api://00000000-0000-0000-0000-000000000000/Packs.ReadWrite

# ---------- Behaviour ----------
# Shown on the "Writing your lesson" card ("about N minutes").
VITE_EXPECTED_MINUTES=3
# How often the app checks a pack that is still being written.
VITE_POLL_SECONDS=5
